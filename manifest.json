{
  "manifest_version": 3,
  "name": "音乐频谱",
  "plugin_id": "audio-viz",
  "version": "1.4.1",
  "description": "全屏歌词页的真实音频频谱。WASAPI 环回逐声道分析、相位安全合并 64 个对数频段；补齐低分辨率空频段，歌词设置面板支持屏幕内滚动。",
  "moekoe": true,
  "minversion": "1.7.0",
  "author": {
    "name": "SHIYI"
  },
  "permissions": [
    "storage"
  ],
  "moekoe_permissions": [
    "moekoe:nativeHost"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "file:///*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_start"
    }
  ],
  "moekoe_native_hosts": [
    {
      "id": "spectrum-sink",
      "auto_start": true,
      "bridge": "bridge.html",
      "platforms": {
        "win32": {
          "path": "host/spectrum-sink.exe",
          "args": []
        }
      }
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "bridge.html",
        "bridge.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
